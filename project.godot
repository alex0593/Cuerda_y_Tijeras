; Engine configuration file.
; Cuerda y Tijeras — vertical slice Godot 4.x

config_version=5

[application]

config/name="Cuerda y Tijeras"
config/description="Roguelite 2D cenital: Lela, tension y rebobinado. Vertical slice 5-10 min."
run/main_scene="res://gameplay/main/game.tscn"
config/icon="res://icon.svg"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.93, 0.88, 0.78, 1)

[autoload]

GameState="*res://core/game_state.gd"
SaveService="*res://core/save_service.gd"
SynergyDB="*res://core/synergy_db.gd"
RoomGenerator="*res://core/room_generator.gd"
PlatformService="*res://platform/platform_service.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/default_font_multichannel_signed_distance_field=true

